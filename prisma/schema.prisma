generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth (Auth.js / NextAuth) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  referralCode  String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  invitesSent   CompanyInvite[] @relation("InviteSender")
  referralsMade AffiliateReferral[] @relation("Referrer")
  referredBy    AffiliateReferral[] @relation("Referee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Multi-tenant company ---

model Company {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  gstin        String?
  stateCode    String   // e.g. "27" Maharashtra
  stateName    String
  addressLine1 String?
  city         String?
  pincode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  ledgers      Ledger[]
  voucherTypes VoucherType[]
  vouchers     Voucher[]
  parties      Party[]
  items        Item[]
  godowns      Godown[]
  stockEntries StockEntry[]
  eInvoices    EInvoiceRecord[]
  eWayBills    EWayBillRecord[]
  invites      CompanyInvite[]
  subscription CompanySubscription?
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   // owner | accountant | ca_viewer
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// --- Chart of Accounts (Indian-style groups) ---

model LedgerGroup {
  id        String   @id @default(cuid())
  companyId String
  name      String
  nature    String   // asset | liability | income | expense | equity
  parentId  String?
  createdAt DateTime @default(now())
  ledgers   Ledger[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Ledger {
  id           String   @id @default(cuid())
  companyId    String
  groupId      String?
  name         String
  code         String?
  isSystem     Boolean  @default(false)
  gstRole      String?  // output_cgst | output_sgst | output_igst | input_cgst | input_sgst | input_igst | sales | purchase | null
  openingDr    Decimal  @default(0)
  openingCr    Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group        LedgerGroup? @relation(fields: [groupId], references: [id])
  lines        VoucherLine[]

  @@unique([companyId, name])
  @@index([companyId])
}

// --- Parties (customers / suppliers) ---

model Party {
  id        String   @id @default(cuid())
  companyId String
  name      String
  gstin     String?
  stateCode String?
  stateName String?
  partyType String   @default("customer") // customer | supplier | both
  ledgerId  String?  // linked sundry debtor/creditor ledger
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers  Voucher[]

  @@unique([companyId, name])
  @@index([companyId])
}

// --- Inventory ---

model Godown {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockEntries StockEntry[]

  @@unique([companyId, name])
}

model Item {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  sku          String?
  hsnSac       String?
  unit         String   @default("NOS")
  gstRatePct   Decimal  @default(18)
  salesPrice   Decimal  @default(0)
  purchasePrice Decimal @default(0)
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherItems VoucherItem[]
  stockEntries StockEntry[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockEntry {
  id        String   @id @default(cuid())
  companyId String
  itemId    String
  godownId  String
  qtyIn     Decimal  @default(0)
  qtyOut    Decimal  @default(0)
  voucherId String?
  note      String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id])
  godown    Godown   @relation(fields: [godownId], references: [id])
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  @@index([companyId, itemId])
  @@index([voucherId])
}

// --- Vouchers (double-entry) ---

model VoucherType {
  id           String    @id @default(cuid())
  companyId    String
  name         String    // Sales | Purchase | Payment | Receipt | Journal | Contra
  abbreviation String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers     Voucher[]

  @@unique([companyId, name])
}

model Voucher {
  id            String   @id @default(cuid())
  companyId     String
  voucherTypeId String
  number        String
  date          DateTime
  partyId       String?
  narration     String?
  placeOfSupply String?  // state code
  isIntraState  Boolean  @default(true)
  taxableAmount Decimal  @default(0)
  cgstAmount    Decimal  @default(0)
  sgstAmount    Decimal  @default(0)
  igstAmount    Decimal  @default(0)
  totalAmount   Decimal  @default(0)
  status        String   @default("posted") // draft | posted | cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherType   VoucherType @relation(fields: [voucherTypeId], references: [id])
  party         Party?   @relation(fields: [partyId], references: [id])
  lines         VoucherLine[]
  items         VoucherItem[]
  stockEntries  StockEntry[]
  eInvoices     EInvoiceRecord[]
  eWayBills     EWayBillRecord[]

  @@unique([companyId, voucherTypeId, number])
  @@index([companyId, date])
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  ledgerId  String
  debit     Decimal @default(0)
  credit    Decimal @default(0)
  narration String?
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger    Ledger  @relation(fields: [ledgerId], references: [id])

  @@index([voucherId])
  @@index([ledgerId])
}

model VoucherItem {
  id            String  @id @default(cuid())
  voucherId     String
  itemId        String
  quantity      Decimal
  rate          Decimal
  taxableAmount Decimal
  gstRatePct    Decimal
  cgstAmount    Decimal @default(0)
  sgstAmount    Decimal @default(0)
  igstAmount    Decimal @default(0)
  voucher       Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  item          Item    @relation(fields: [itemId], references: [id])

  @@index([voucherId])
}

// --- GSTN compliance stubs (status storage) ---

model EInvoiceRecord {
  id          String   @id @default(cuid())
  companyId   String
  voucherId   String
  status      String   @default("pending") // pending | stub_ok | stub_failed | cancelled
  irn         String?
  qrCode      String?
  message     String?
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([voucherId])
}

model EWayBillRecord {
  id           String   @id @default(cuid())
  companyId    String
  voucherId    String
  status       String   @default("pending") // pending | stub_ok | stub_failed | cancelled
  ewayBillNo   String?
  vehicleNumber String?
  distanceKm   Int?
  message      String?
  requestedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([voucherId])
}

// --- CA invite / share ---

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        String    @default("ca_viewer") // ca_viewer | accountant
  token       String    @unique
  status      String    @default("pending") // pending | accepted | revoked
  invitedById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
}

// --- Affiliate (no live payouts) ---

model AffiliateReferral {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String?
  refereeEmail String?
  code        String
  status      String   @default("pending") // pending | converted | paid_stub
  createdAt   DateTime @default(now())
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
  referee     User?    @relation("Referee", fields: [refereeId], references: [id])
  earnings    AffiliateEarning[]

  @@index([referrerId])
  @@index([code])
}

model AffiliateEarning {
  id          String   @id @default(cuid())
  referralId  String
  amountInr   Decimal  @default(0)
  planCode    String?
  status      String   @default("accrued") // accrued | payout_pending | paid_stub
  note        String?
  createdAt   DateTime @default(now())
  referral    AffiliateReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
}

// --- Pricing / subscription (checkout stubbed) ---

model PricingPlan {
  id            String   @id @default(cuid())
  code          String   @unique // starter | growth | business
  name          String
  priceInrMonthly Int
  description   String?
  featuresJson  String   @default("[]")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  planId             String
  status             String   @default("trial") // trial | active | past_due | cancelled | checkout_stub
  currentPeriodEnd   DateTime?
  paymentProviderRef String?  // TODO: set when live PG wired
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan               PricingPlan @relation(fields: [planId], references: [id])
}
